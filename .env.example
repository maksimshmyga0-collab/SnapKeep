# -----------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# Found in your Supabase Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"

# Service Role Key (Keep this secret! NEVER expose it to client-side/frontend code)
# Used by Vercel Serverless Functions to read/write with full backend privileges
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Public URL of your deployed application on Vercel (without trailing slash)
# Example: https://snap-keep-omega.vercel.app
APP_URL="https://snap-keep-omega.vercel.app"
